{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && vite",
    "inventory": "node scripts/inventory-site.mjs",
    "assets": "node scripts/fetch-selected-assets.mjs",
    "panorama:assets": "node scripts/localize-panoramas.mjs",
    "panorama:links": "node scripts/import-panorama-links.mjs",
    "content:import": "node scripts/import-current-content.mjs",
    "content:build": "node scripts/compile-content.mjs",
    "build": "npm run content:build && vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "npm run content:build && vite build && node scripts/create-pages-404.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/app.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "pannellum": "^2.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.6",
    "sanitize-html": "^2.17.4",
    "turndown": "^7.2.2"
  }
}
